      "item": [
        {
          "name": "CP-01 Crear usuario válido (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laura\",\n  \"apellido\": \"Gómez\",\n  \"username\": \"lgomez\",\n  \"password\": \"clave1234\",\n  \"rol\": \"OPERARIO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"nuevoUsuarioId\", j.idUsuario);",
                  "pm.test(\"Queda activo y sin contraseña en la respuesta\", function () { pm.expect(j.activo).to.eql(true); pm.expect(j).to.not.have.property(\"passwordHash\"); pm.expect(j).to.not.have.property(\"password\"); });"
                ]
              }
            }
          ]
        },
